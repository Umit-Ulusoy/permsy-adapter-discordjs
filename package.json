{
  "name": "@permsy/adapter-discordjs",
  "version": "1.0.0",
  "description": "Official Discord.js adapter for the Permsy permission management engine.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js"
  },
  "keywords": [
    "permsy",
    "discordjs",
    "discord.js",
    "adapter",
    "permissions",
    "authorization",
    "discord-bot",
    "rbac"
  ],
  "author": "Ümit ULUSOY",
  "license": "MIT",
  "homepage": "https://github.com/Umit-Ulusoy/permsy-adapter-discordjs#readme",
  "bugs": {
    "url": "https://github.com/Umit-Ulusoy/permsy-adapter-discordjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umit-Ulusoy/permsy-adapter-discordjs.git"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0",
    "permsy": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "discord.js": "^14.16.3",
    "permsy": "^1.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
